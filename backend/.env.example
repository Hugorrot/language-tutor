# Copy this file to .env and paste the shared key. Never commit .env.
OPENAI_API_KEY=sk-...

# Offline mode: no key needed, no cost. Canned answers, separate database in data/fake/.
# FAKE_LLM=1

# Optional overrides (defaults live in config.py)
# LLM_MODEL=gpt-6-luna
# ASR_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_MODE=vector        # vector | sql | none  (sql and none are evaluation baselines)
